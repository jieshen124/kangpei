[Unit]
Description=Chat server (Node.js + WebSocket)
After=network.target

[Service]
Type=simple
User=chat
Group=chat
WorkingDirectory=/opt/chat
ExecStart=/usr/bin/node /opt/chat/server.js
Restart=always
RestartSec=3
Environment=NODE_ENV=production

# 最小权限加固
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ReadWritePaths=/var/lib/chat

StandardOutput=journal
StandardError=journal
SyslogIdentifier=chat

[Install]
WantedBy=multi-user.target
